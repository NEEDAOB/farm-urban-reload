-- ลูปการทำงานหลัก (MAIN LOOPS)
-- =========================================================
task.spawn(function()
while true do
task.wait(CONFIG.WEAPON_CHECK)
forceEquipWeapon()
end
end)

task.spawn(function()
while true do
task.wait(1)
local current = getMoney()
if current then
if lastMoney == nil then
lastMoney = current
moneyStart = current
end
if current > lastMoney then
CONFIG.MONEY_GAINED = CONFIG.MONEY_GAINED + (current - lastMoney)
pcall(function() moneyLabel:Set("เงินที่ได้รับ : " .. CONFIG.MONEY_GAINED) end)
end
lastMoney = current
end
end
end)

task.spawn(function()
while true do
task.wait(0.03)

    local list = getAllZombies()
    pcall(function() zombieCountLabel:Set("จำนวนซอมบี้ในพื้นที่ : " .. #list) end)

    if not CONFIG.ENABLED or not state.firing then
        releaseRightClick()
        pcall(function()
            if not CONFIG.ENABLED then
                statusLabel:Set("สถานะ : ปิดใช้งานสคริปต์")
            else
                statusLabel:Set("สถานะ : พร้อมใช้งาน (กด F)")
            end
        end)
        state.shotsInBurst = 0
        continue
    end

    local myChar = player.Character
    if not myChar or not myChar:FindFirstChildOfClass("Humanoid") then
        releaseRightClick()
        continue
    end
    if myChar.Humanoid.Health <= 0 then
        releaseRightClick()
        continue
    end

    if #list == 0 then
        releaseRightClick()
        pcall(function() statusLabel:Set("สถานะ : ไม่พบซอมบี้ใน HoodLocal") end)
        continue
    end

    local bestTarget, bestDist = nil, math.huge
    for _, entry in ipairs(list) do
        local aimPos = entry.aimPart.Position + CONFIG.AIM_OFFSET
        if hasLineOfSight(camera.CFrame.Position, aimPos) and entry.dist < bestDist then
            bestDist = entry.dist
            bestTarget = entry
        end
    end

    if not bestTarget then
        releaseRightClick()
        pcall(function() statusLabel:Set("สถานะ : ซอมบี้อยู่นอกสายตา / มีสิ่งกีดขวาง") end)
        continue
    end

    if bestTarget.hum.Health <= 0 then
        state.shotsInBurst = 0
        continue
    end

    holdRightClick()

    if tick() - state.lastBurst < CONFIG.BURST_PAUSE then continue end
    if tick() - state.lastShot  < CONFIG.SHOT_DELAY  then continue end

    local aimPos = bestTarget.aimPart.Position + CONFIG.AIM_OFFSET
    camera.CFrame = CFrame.new(camera.CFrame.Position, aimPos)

    local camLook = camera.CFrame.LookVector
    local toTarget = (aimPos - camera.CFrame.Position).Unit
    local dot = camLook:Dot(toTarget)

    pcall(function()
        statusLabel:Set(string.format("ยิงหัว - ระยะ %.0f studs | ค่าความตรง %.2f", bestDist, dot))
    end)

    if dot >= CONFIG.AIM_STRICT and bestTarget.hum.Health > 0 then
        VIM:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        task.wait(0.02)
        VIM:SendMouseButtonEvent(0, 0, 0, false, game, 0)
        spamKey()
        state.lastShot = tick()
        state.shotsInBurst = state.shotsInBurst + 1
        if state.shotsInBurst >= CONFIG.BURST_SIZE then
            state.shotsInBurst = 0
            state.lastBurst = tick()
        end
    end
end
end)

